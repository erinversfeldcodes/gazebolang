/target
/crates/*/target

# Leptos build output
/crates/web/target

# editor/'s compiled output (npm run build) — generated, not source; built
# fresh by CI/deploy the same way cargo-leptos's own pkg/ output is, never
# committed. editor/'s own source + package-lock.json are still tracked.
/crates/web/public/*.js
/crates/web/public/*.css

# Local secrets
.env
.env.local

# Nix
.direnv/

# Editor/OS cruft
.DS_Store
.neon
node_modules/

# Playwright E2E (crates/web has its own target dir ignore above; this is e2e/)
e2e/.auth/
e2e/playwright-report/
e2e/test-results/
